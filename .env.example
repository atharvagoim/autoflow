# AutoFlow — the only config file. Copy to .env (npm run setup does this for you).
# Your existing FinFlow .env works as-is: the variable names are the same.

# ---- Required -------------------------------------------------------------
# Local MongoDB, or MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/finflow_ai
MONGO_URI=mongodb://127.0.0.1:27017/finflow_ai

# Use long random strings in production (e.g. `openssl rand -hex 32`).
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# ---- Server ---------------------------------------------------------------
PORT=5050
# NODE_ENV is set by your host (Render/Docker set it to production) — leave it out of this file.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Run automations inside the web server. Set to false only if you run
# `npm run worker` as a separate process.
RUN_WORKER_INLINE=true

# Creates the demo account (demo@autoflow.app / Password123!) and shows the
# "Try the demo" button. Set to false on a real production site.
AUTO_SEED=true

# ---- Optional (features fall back gracefully when blank) ------------------
# AI-written messages, smarter expense categories and assistant answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Real email delivery for "Send an email" steps.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AutoFlow <no-reply@autoflow.app>

# Default Slack channel for "Post to Slack" steps.
SLACK_WEBHOOK_URL=

# ---- Rarely needed --------------------------------------------------------
# Only if you host the web app on a different domain from the API:
# CLIENT_URL=https://your-frontend.example.com   (comma-separate several)
# VITE_API_URL=https://your-api.example.com/api  (read at build time)
