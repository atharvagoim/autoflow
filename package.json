{
  "name": "autoflow",
  "version": "1.0.0",
  "private": true,
  "description": "AutoFlow — no-code money automations for small businesses (API + web app in one service)",
  "main": "dist/server/server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "setup": "npm install && node -e \"require('fs').existsSync('.env')||require('fs').copyFileSync('.env.example','.env')\"",
    "dev": "concurrently -k -n api,web -c magenta,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "nodemon --watch backend/src --ext ts --exec ts-node --project backend/tsconfig.json backend/src/server.ts",
    "dev:web": "vite --config frontend/vite.config.mts",
    "build": "vite build --config frontend/vite.config.mts && tsc -p backend/tsconfig.json",
    "start": "node dist/server/server.js",
    "seed": "ts-node --project backend/tsconfig.json backend/src/seed.ts",
    "seed:prod": "node dist/server/seed.js",
    "worker": "node dist/server/automation/worker.js",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.17.12",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.8",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vercel/functions": "^3.9.11",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.16",
    "openai": "^4.77.0",
    "pdfkit": "^0.15.2",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "concurrently": "^9.1.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "ts-jest": "^29.2.5"
  }
}
